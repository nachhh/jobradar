# Copy to .env (git-ignored) and fill in. Every variable the app reads is listed here.
# Real environment variables override .env (that's how CI configures the app).

# Matches docker-compose.yml. Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5434/jobradar
TEST_DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5434/jobradar_test

# LLM providers (Phase 2). Claude: https://console.anthropic.com (paid, ~$1 per full enrichment pass).
# Free tiers: https://aistudio.google.com (Gemini) and https://console.groq.com (Groq, not used yet).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Which provider `jobradar enrich` calls: claude or gemini.
LLM_PROVIDER=claude
# Enrichment calls in flight at once, and the most calls one run may make.
ENRICH_CONCURRENCY=4
ENRICH_MAX_CALLS=3000

# Retrieval (Phase 2). Where the local embedding model is downloaded on first use (~1.2 GB).
FASTEMBED_CACHE_PATH=.cache/fastembed

# Job sources (Phase 1). Optional; free key at https://himalayas.app/api-keys (raises the rate limit).
HIMALAYAS_API_KEY=

LOG_LEVEL=INFO
